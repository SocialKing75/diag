# Copier ce fichier en ".env" et remplir les valeurs

# Telegram Bot Token - obtenu via @BotFather sur Telegram.
# Pour ce projet, utiliser uniquement @Veilleregle_bot.
TELEGRAM_BOT_TOKEN=123456789:ABCDEFabcdef...

# Cle API OpenAI - https://platform.openai.com/api-keys (format sk-... ou sk-proj-...)
OPEN_IA=sk-...
# Modele OpenAI (optionnel, defaut: gpt-4o)
OPENAI_MODEL=gpt-4o

# Chemin du dossier Dropbox (optionnel, valeur par defaut dans le code)
RAPPORTS_DIR=C:\Users\Assistante\Dropbox\Parasitis\RAPPORTS 2010

# Configuration IONOS Mail (optionnel)
IONOS_SMTP_SERVER=smtp.ionos.fr
IONOS_SMTP_PORT=587
IONOS_EMAIL=votre-email@votredomaine.fr
IONOS_PASSWORD=votre-mot-de-passe-app
IONOS_FROM_NAME=OpenClaw Diagnostics
